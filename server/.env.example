# ---------------------------------------------------------------
# Copy this file to ".env" (same folder) and fill in real values.
# NEVER commit the real .env file - it is listed in .gitignore.
# ---------------------------------------------------------------

# Port the API listens on
PORT=5000

# "development" locally, "production" on Render
NODE_ENV=development

# --- Local PostgreSQL (what you installed with pgAdmin on Windows) ---
PGHOST=localhost
PGPORT=5432
PGDATABASE=campus_relay
PGUSER=postgres
PGPASSWORD=put_your_postgres_password_here

# --- Hosted PostgreSQL (Neon) ---
# When you deploy, leave the five PG* values above blank and set this
# single connection string instead. If DATABASE_URL is present it wins.
DATABASE_URL=

# Sign your JWTs with a long random string. Generate one by running:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d

# Comma-separated list of frontends allowed to call this API
CORS_ORIGIN=http://localhost:5173
